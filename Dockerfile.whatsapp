FROM node:20-slim

WORKDIR /app

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm ci --omit=dev

COPY . .

EXPOSE 3000

ENV PORT=3000
ENV HAWAS_API_URL=https://hawas-worker.hawas-alertai.workers.dev/api/chat

CMD ["node", "scripts/whatsapp-bridge.js"]
